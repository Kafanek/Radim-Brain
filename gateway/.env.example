# ===================================================================
# RadimCare Tapo Gateway — environment template
# ===================================================================
# Copy to C:\RadimCare\.env (Windows) or /etc/radimcare-gateway.env (Linux)
# and fill in real values. NIKDY necommituj skutečný .env do gitu!
# ===================================================================

# TP-Link Tapo account (provider auth)
TAPO_EMAIL=iot@radimcare.cz
TAPO_PASSWORD=

# Heroku backend
RADIM_API_BASE=https://radim-brain-2025-be1cd52b04dc.herokuapp.com
IOT_GATEWAY_TOKEN=

# Senior identification
RADIM_SENIOR_ID=
RADIM_ROOM_PREFIX=byt_demo

# Polling cadence (seconds)
POLL_INTERVAL_SECONDS=30

# Static IPs of Wi-Fi devices (set v routeru přes DHCP reservation, jinak
# by se mohly měnit a poller by je ztratil. Zjisti IP v Tapo app → Settings
# → Device Info → IP Address, a zaregistruj v routeru.)
TAPO_P115_RYCHLOVARKA_IP=192.168.1.50
TAPO_P115_MIKROVLNKA_IP=192.168.1.51
TAPO_L510E_LOZNICE_IP=192.168.1.52
TAPO_H110_IP=192.168.1.53

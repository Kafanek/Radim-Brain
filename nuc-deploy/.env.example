# ============================================
# RADIM BRAIN - NUC Environment Variables
# ============================================
# Zkopiruj jako .env a vyplň hodnoty:
#   cp .env.example .env
#   nano .env
# ============================================

# ─── Database ───
DB_PASSWORD=CHANGE_ME_silne_heslo_min_20_znaku

# ─── Public URL (Cloudflare Tunnel nebo vlastni domena) ───
PUBLIC_URL=https://brain.radimcare.cz

# ─── Azure Speech (TTS + STT) ───
# POZOR: app.py pouziva AZURE_TTS_*, docker-compose mapuje obe varianty automaticky
AZURE_TTS_KEY=your_azure_speech_key_here
AZURE_TTS_REGION=westeurope

# ─── AI Providers ───
ANTHROPIC_API_KEY=sk-ant-xxxxx
GEMINI_API_KEY=AIzaSyxxxxx
# OpenAI (volitelne, fallback)
OPENAI_API_KEY=

# ─── ElevenLabs TTS (volitelne) ───
ELEVENLABS_API_KEY=

# ─── Twilio (telefonni hovory) ───
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=xxxxx
TWILIO_PHONE_NUMBER=+420xxxxx

# ─── Push Notifications (VAPID) ───
VAPID_PRIVATE_KEY=xxxxx
VAPID_PUBLIC_KEY=xxxxx
VAPID_EMAIL=mailto:radim@radimcare.cz

# ─── Cloudinary (media, volitelne) ───
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── WordPress (volitelne) ───
WP_URL=
WP_USER=
WP_APP_PASSWORD=

# ─── JWT Auth + Flask Secret ───
# Stejna hodnota pro JWT_SECRET i SECRET_KEY
JWT_SECRET=CHANGE_ME_nahodny_retezec_min_32_znaku

# ─── WordPress JWT Secret (pro auth tokeny z WP) ───
# Musis nastavit stejny secret jako v WordPress JWT plugin
WP_JWT_SECRET=CHANGE_ME_wp_jwt_secret

# ─── SMTP (email, volitelne) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
